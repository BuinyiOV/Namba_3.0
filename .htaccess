# ----------------------------------------------------------------------
# 1. ПРІОРИТЕТ ГОЛОВНОГО ФАЙЛУ (Рішення для пробиття кешу на iPhone)
# ----------------------------------------------------------------------
# Змушує сервер відкривати home.html замість закешованого index.html
DirectoryIndex home.html index.html index.php

# ----------------------------------------------------------------------
# 2. ПЕРЕНАПРАВЛЕННЯ НА HTTPS (Без помилок синтаксису 500)
# ----------------------------------------------------------------------
# Автоматично переводить усіх клієнтів на безпечне з'єднання https://
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://nambasushi.pl [R=301,L]

# ----------------------------------------------------------------------
# 3. ПРИМУСОВЕ СКИДАННЯ КЕШУ ДЛЯ HTML-СТОРІНОК НА SERVERS HOME.PL
# ----------------------------------------------------------------------
# Змушує браузери старих клієнтів завантажувати новий код сторінки,
# але дозволяє кешувати картинки суші для швидкого завантаження сайту.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "max-age=0, private, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
